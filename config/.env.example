# Full path to the directory containing WORKSPACE repos.
# Absolute path used as-is. Relative path is resolved from the workspace-ia-toolkit directory.
# Note: when running from a workspace (workspace-ia-toolkit is a symlinked repo inside the workspace),
# relative paths will not resolve correctly — use an absolute path in that case.
# Examples:
#   WORKSPACE_REPOSITORIES_DIR=/Users/you/projects/repositories  (absolute)
#   WORKSPACE_REPOSITORIES_DIR=../repositories                    (relative: sibling of workspace-ia-toolkit)
WORKSPACE_REPOSITORIES_DIR=../repositories

# WORKSPACE statusline (status bar) opt-in for generated workspaces.
# Set automatically the first time generate-workspace.sh prompts you interactively
# — subsequent runs read this value and skip the prompt. Accepted values: true, false
# (case-insensitive; anything else is treated as unset and you'll be prompted again).
# A one-off --no-workspace-statusline flag disables it for a single run without
# overwriting this persisted value.
# WORKSPACE_STATUSLINE=true

# Package manager cache directories — shared across all workspaces on this machine.
# Defaults to standard locations in your home dir. Override only if needed.
# YARN_CACHE_DIR=~/.yarn/cache
# GRADLE_CACHE_DIR=~/.gradle
# M2_CACHE_DIR=~/.m2
# NPM_CACHE_DIR=~/.npm

# AWS / ArtifactRegistry — per-machine, not universal. Set these only if your AWS
# setup differs from the defaults (profile `example-dev` in ~/.aws/config). The
# auth scripts read them from here so you don't have to export them each time.
# Precedence: exported env var > this file > built-in default.
#   AWS_PROFILE          your AWS profile name for ArtifactRegistry/STS auth
#                        (default: example-dev). Honored ONLY by the ArtifactRegistry
#                        scripts (ensure-token.sh, probe-artifact_registry.sh).
#                        The Kubernetes script (kube-token.sh) does NOT use this:
#                        it derives a fixed profile per cluster, `example-<env>`
#                        (example-dev / example-prod / example-shared), matching the
#                        cluster names — so one AWS_PROFILE can't address all
#                        three. To use Kubernetes, create those `example-<env>` profiles
#                        in your aws config (or point AWS_CONFIG_FILE at a config
#                        that defines them).
#   AWS_CONFIG_FILE      path to your aws config if NOT ~/.aws/config
#                        (e.g. a separate WORKSPACE config: ~/.aws-workspace/config)
#   AWS_DEFAULT_REGION   default: us-east-1
#   ARTIFACT_REGISTRY_DOMAIN  default: example-corp
#   ARTIFACT_REGISTRY_DOMAIN_OWNER  AWS account id owning the domain (default: 123456789012)
# AWS_PROFILE=workspace
# AWS_CONFIG_FILE=~/.aws-workspace/config
# AWS_DEFAULT_REGION=us-east-1
# ARTIFACT_REGISTRY_DOMAIN=example-corp
# ARTIFACT_REGISTRY_DOMAIN_OWNER=123456789012
