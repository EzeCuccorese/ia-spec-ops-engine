# Full path to the directory containing local project repositories.
# Absolute path used as-is. Relative path is resolved from the specops directory.
# Examples:
#   SPECOPS_REPOSITORIES_DIR=/Users/you/projects/repositories  (absolute)
#   SPECOPS_REPOSITORIES_DIR=../repositories                   (relative: sibling of specops)
SPECOPS_REPOSITORIES_DIR=../repositories
AI_REPOSITORIES_DIR=../repositories

# AI statusline (status bar) opt-in for generated workspaces.
# Accepted values: true, false
# AI_STATUSLINE=true

# Confines suggested Git worktree destinations for the Claude WorktreeCreate
# integration hook (`ws hook claude-worktree-create`). Suggestions are sanitized
# and never leave this directory; the hook never creates the worktree itself.
# Default: ~/projects/worktree
# SPECOPS_WORKTREES_DIR=~/projects/worktree

# Base directory for the user-global SpecOps configuration file used by
# `ws config init --global` (config lives at $XDG_CONFIG_HOME/specops/config.json).
# Default: ~/.config
# XDG_CONFIG_HOME=~/.config

# Controls verbosity of the pre-push Quality Gate hook / `ws hooks run` output.
# Accepted values: errors (hide successful command output), verbose (stream everything).
# Default: errors
# QG_OUTPUT=errors

# Package manager cache directories — shared across all workspaces on this machine.
# Defaults to standard locations in your home dir. Override only if needed.
# YARN_CACHE_DIR=~/.yarn/cache
# GRADLE_CACHE_DIR=~/.gradle
# M2_CACHE_DIR=~/.m2
# NPM_CACHE_DIR=~/.npm

# AWS / ArtifactRegistry configuration (placeholders).
#   AWS_PROFILE          your AWS profile name (e.g. dev-profile)
#   AWS_CONFIG_FILE      path to your aws config (e.g. ~/.aws/config)
#   AWS_DEFAULT_REGION   default: us-east-1
#   ARTIFACT_REGISTRY_DOMAIN  default: my-company-domain
#   ARTIFACT_REGISTRY_DOMAIN_OWNER  AWS account id owning the domain (e.g. 123456789012)
# AWS_PROFILE=default
# AWS_CONFIG_FILE=~/.aws/config
# AWS_DEFAULT_REGION=us-east-1
# ARTIFACT_REGISTRY_DOMAIN=my-company-domain
# ARTIFACT_REGISTRY_DOMAIN_OWNER=123456789012
