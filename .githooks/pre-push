#!/usr/bin/env bash
set -e

# Colored logging
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "${BLUE}[Devscripts Pre-Push Hook] Ejecutando Quality Gate local completo...${NC}"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$REPO_ROOT"

# 1. SEGURIDAD: Escaneo de secretos, tokens y archivos prohibidos
echo -e "${CYAN}🔒 [1/4] Verificando seguridad y escaneo de secretos...${NC}"
FORBIDDEN_FILES=$(git ls-files | grep -E '(\.env(\..+)?$|\.pem$|\.key$|id_rsa$|id_ed25519$|credentials\.json$|\.DS_Store$)' | grep -v '\.env\.example' || true)
if [ -n "$FORBIDDEN_FILES" ]; then
    echo -e "${RED}❌ ERROR DE SEGURIDAD: Se detectaron archivos sensibles trackeados en Git:${NC}"
    echo "$FORBIDDEN_FILES"
    echo -e "${YELLOW}Elimínalos del tracking con 'git rm --cached <archivo>' antes de pushear.${NC}"
    exit 1
fi

DIFF_CONTENT=$(git diff HEAD~1..HEAD 2>/dev/null || git diff --cached 2>/dev/null || true)
if [ -n "$DIFF_CONTENT" ]; then
    LEAK_PATTERNS='(BEGIN (RSA|EC|OPENSSH|PRIVATE) KEY|AKIA[0-9A-Z]{16}|ghp_[a-zA-Z0-9]{36}|sk-[a-zA-Z0-9]{20,}|AIza[0-9A-Za-z-_]{35})'
    DETECTED_LEAKS=$(echo "$DIFF_CONTENT" | grep -E "^\+[^+]" | grep -E "$LEAK_PATTERNS" || true)
    if [ -n "$DETECTED_LEAKS" ]; then
        echo -e "${RED}❌ ERROR DE SEGURIDAD: Se detectaron posibles secretos/tokens en el diff:${NC}"
        echo "$DETECTED_LEAKS" | head -n 5
        echo -e "${YELLOW}Utiliza variables de entorno antes de pushear.${NC}"
        exit 1
    fi
fi
echo -e "${GREEN}✔ Seguridad y Secretos: PASS${NC}"

# 2. POLÍTICAS GIT: Cero menciones de IA
echo -e "${CYAN}📝 [2/4] Verificando políticas de commit (cero menciones IA)...${NC}"
RECENT_MESSAGES=$(git log -n 5 --format=%B 2>/dev/null || true)
if echo "$RECENT_MESSAGES" | grep -Eqi '(generated (by|with) ai|co-authored-by:.*(claude|gpt|gemini|copilot)|🤖|🦾)'; then
    echo -e "${RED}❌ ERROR DE POLÍTICA GIT: Se detectaron menciones de IA en los mensajes de commit recientes.${NC}"
    exit 1
fi
echo -e "${GREEN}✔ Políticas Git: PASS${NC}"

# 3. LINTER: Ruff
echo -e "${CYAN}🔍 [3/4] Ejecutando linter (Ruff)...${NC}"
if command -v ruff >/dev/null 2>&1; then
    ruff check packages/ rules/ < /dev/null || { echo -e "${RED}❌ Falló la verificación de linter con ruff.${NC}"; exit 1; }
elif command -v uv >/dev/null 2>&1; then
    uv run --with ruff ruff check packages/ rules/ < /dev/null || { echo -e "${RED}❌ Falló la verificación de linter con ruff (uv).${NC}"; exit 1; }
fi
echo -e "${GREEN}✔ Linter Ruff: PASS${NC}"

# 4. PRUEBAS: Pytest
echo -e "${CYAN}🧪 [4/4] Ejecutando suite de tests (Pytest)...${NC}"
pytest < /dev/null || { echo -e "${RED}❌ Falló la suite de tests unitarios/integración.${NC}"; exit 1; }
echo -e "${GREEN}✔ Suite Pytest: PASS${NC}"

echo -e "${GREEN}🚀 Quality Gate superado con éxito. Procediendo con git push...${NC}"
exit 0
