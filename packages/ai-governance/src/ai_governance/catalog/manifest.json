      "fail_mode": "open"
    },
    {
      "id": "telemetry-usage",
      "package": "ai-governance",
      "command": "telemetry usage --json",
      "purpose": "Report local usage estimate (spend and tokens) from session transcripts.",
      "trigger": "on-demand",
      "io": {
        "stdin": "text",
        "stdout": "json"
      },
      "replaces": [
        "grep/parse ~/.claude/projects/**/*.jsonl"
      ],
      "fail_mode": "open"
    }
  ]
