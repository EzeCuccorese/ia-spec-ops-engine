#!/usr/bin/env bash
# Workspace commit-msg hook: Conventional Commits subject (registered as hook.workspace-commit-msg).
# Opt-in per repository, like the pre-push commit policy, so a global install never
# imposes a style on projects with their own conventions:
#   git config workspace.commitStyle conventional   (or QG_COMMIT_STYLE=conventional)
# Skip once with: QG_SKIP=commits git commit ...
set -uo pipefail
# ws lives in a per-user directory that IDE and desktop Git clients leave off PATH: look there
# before loading the config files (not found: the scripts keep their built-in behavior).
if ! command -v ws >/dev/null 2>&1; then
  for qg_dir in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin "$HOME/.cargo/bin"; do
    if [ -x "$qg_dir/ws" ]; then PATH="$PATH:$qg_dir"; export PATH; break; fi
  done
fi
if command -v ws >/dev/null 2>&1; then  # [gate] of .workspace/config.toml (repo) / user config
  eval "$(ws hooks gate-config --dir "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" 2>/dev/null)" || true
fi
case ",${QG_SKIP:-}," in *,commits,*|*,all,*) exit 0 ;; esac
style="${QG_COMMIT_STYLE:-$(git config --get workspace.commitStyle 2>/dev/null || true)}"
[ "$style" = "conventional" ] || exit 0
subject="$(grep -v '^#' "$1" | head -n 1)"
case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
if ! printf '%s' "$subject" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+'; then
  echo "commit-msg: subject must follow Conventional Commits: type(scope): description" >&2
  echo "  got: $subject" >&2
  exit 1
fi
if [ "${#subject}" -gt 100 ]; then
  echo "commit-msg: subject is ${#subject} characters (max 100)" >&2
  exit 1
fi
exit 0
