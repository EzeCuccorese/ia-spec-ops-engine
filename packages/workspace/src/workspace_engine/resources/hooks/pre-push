#!/usr/bin/env bash
# Workspace Quality Gate pre-push hook
# Registered as a Git config-based hook (never core.hooksPath):
#   git config [--global] hook.workspace-gate.event pre-push
#   git config [--global] hook.workspace-gate.command <path-to-this-script>
# Git runs it first and the repository's own pre-push hook (Husky, .git/hooks) last.
#
# Environment variables:
#   QG_SCOPE=all|changed        Scope of linters and tests (default: all)
#   QG_SKIP=a,b,c               Skip checks: gitleaks,commits,lint,tests,all
#   QG_TIMEOUT=900              Timeout in seconds per step
#   QG_COMMIT_STYLE=conventional  Require Conventional Commits in messages
#   QG_PROTECTED="^(main)$"     Regex of protected branches (override)
#   QG_OUTPUT=errors|verbose    Hide successful output (default: errors)
set -uo pipefail

QG_SCOPE="${QG_SCOPE:-all}"
QG_SKIP="${QG_SKIP:-}"
QG_TIMEOUT="${QG_TIMEOUT:-900}"
QG_COMMIT_STYLE="${QG_COMMIT_STYLE:-}"
QG_OUTPUT="${QG_OUTPUT:-errors}"
PROTECTED_BRANCHES="${QG_PROTECTED:-^(main|master|develop|staging)\$}"

ZERO="0000000000000000000000000000000000000000"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

# Prevents jest/vitest/etc from starting in watch mode and hanging the push forever.
export CI=1

echo "[Quality Gate Pre-Push Hook] Checking quality and security before sending changes..."

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || REPO_ROOT=""
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi
cd "$REPO_ROOT" || exit 1
# Git exports repository-local variables to hooks. They would otherwise leak
# into test subprocesses that create or inspect a different temporary repo.
unset $(git rev-parse --local-env-vars)


FAILED=0
FAILED_STEPS=""
fail() { echo "✘ $1: FAIL"; FAILED=1; FAILED_STEPS="${FAILED_STEPS}  - $1"$'\n'; }
pass() { echo "✔ $1: PASS"; }
warn() { echo "⚠  $1"; }
note() { echo "   $1"; }

case "$QG_OUTPUT" in
  errors|verbose) ;;
  *)
    warn "QG_OUTPUT='$QG_OUTPUT' is not valid; using 'errors'."
    QG_OUTPUT="errors"
    ;;
esac

skipped() {
  case ",${QG_SKIP}," in
    *,all,*) return 0 ;;
    *",$1,"*) return 0 ;;
  esac
  return 1
}

TIMEOUT_BIN=""
if command -v timeout >/dev/null 2>&1; then
  TIMEOUT_BIN="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_BIN="gtimeout"
fi

# Saves the full transcript of a failed command outside the working tree.
persist_failure_log() {
  local rc="$1" command_log="$2"; shift 2
  if ! mkdir -p "$FAILURE_LOG_DIR" 2>/dev/null; then
    warn "Could not create the full log directory: $FAILURE_LOG_DIR"
    return 0
  fi
  if [ "$FAILURE_LOG_READY" = "0" ]; then
    if ! : > "$FAILURE_LOG" 2>/dev/null; then
      warn "Could not write the full log: $FAILURE_LOG"
      return 0
    fi
    chmod 600 "$FAILURE_LOG" 2>/dev/null || true
    FAILURE_LOG_READY=1
  fi
  {
    echo "== Failed command (exit $rc) =="
    printf '%q ' "$@"
    echo ""
    cat "$command_log"
    echo ""
  } >> "$FAILURE_LOG" 2>/dev/null || warn "Could not update: $FAILURE_LOG"
}

show_failed_command() {
  local rc="$1" command_log="$2"; shift 2
  local line_count
  line_count="$(wc -l < "$command_log" | tr -d ' ')"
  echo ""
  echo "   Failed command (exit code $rc):"
  printf '   > '
  printf '%q ' "$@"
  echo ""
  if [ "$line_count" -le 200 ]; then
    cat "$command_log"
  else
    head -n 80 "$command_log"
    echo "   ... output truncated: $line_count lines total ..."
    tail -n 120 "$command_log"
  fi
  persist_failure_log "$rc" "$command_log" "$@"
  if [ "$FAILURE_LOG_READY" = "1" ]; then
    note "Full log: $FAILURE_LOG"
  fi
}

# Runs a command with a time limit, so no hung tool can block the push.
# In errors mode it captures stdout+stderr and only shows them if the command fails.
run_to() {
  local secs="$1"; shift
  local rc=0 command_log=""
  RUN_SEQUENCE=$((RUN_SEQUENCE + 1))
  command_log="$TMPD/command-$RUN_SEQUENCE.log"
  if [ "$QG_OUTPUT" = "verbose" ]; then
    if [ -n "$TIMEOUT_BIN" ]; then
      "$TIMEOUT_BIN" "$secs" "$@"; rc=$?
    elif command -v perl >/dev/null 2>&1; then
      perl -e 'alarm shift; exec @ARGV' "$secs" "$@"; rc=$?
    else
      "$@"; rc=$?
    fi
  else
    if [ -n "$TIMEOUT_BIN" ]; then
      "$TIMEOUT_BIN" "$secs" "$@" > "$command_log" 2>&1; rc=$?
    elif command -v perl >/dev/null 2>&1; then
      perl -e 'alarm shift; exec @ARGV' "$secs" "$@" > "$command_log" 2>&1; rc=$?
    else
      "$@" > "$command_log" 2>&1; rc=$?
    fi
    if [ "$rc" = "0" ]; then
      rm -f "$command_log"
    else
      show_failed_command "$rc" "$command_log" "$@"
    fi
  fi
  if [ "$rc" = "124" ] || [ "$rc" = "142" ]; then
    echo "   ⏱  '$1' exceeded ${secs}s and was aborted (raise QG_TIMEOUT if that is expected)."
  fi
  return $rc
}

TMPD="$(mktemp -d "${TMPDIR:-/tmp}/qg.XXXXXX")" || exit 1
trap 'rm -rf "$TMPD"' EXIT INT TERM
RUN_SEQUENCE=0
FAILURE_LOG_READY=0
FAILURE_LOG_DIR="$(git rev-parse --git-path workspace/quality-gate 2>/dev/null || printf '%s' "$TMPD")"
FAILURE_LOG="$FAILURE_LOG_DIR/latest.log"

# --- stdin -------------------------------------------------------------------
# Git sends one line per ref: "local_ref local_sha remote_ref remote_sha".
# We save it to a file so it can be re-fed to the repo's own hook.
STDIN_FILE="$TMPD/stdin"
cat > "$STDIN_FILE"

LOGOPTS=()   # range in "git log" format for gitleaks / rev-list
BASES=()     # base commit for the diff
TIPS=()      # tip commit for the diff

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref}${local_sha}${remote_ref}${remote_sha}" ] || continue

  # The protected branch is the DESTINATION one (remote_ref), not the local one:
  # otherwise "git push origin feature:main" would slip through unchecked.
  target_ref="$remote_ref"
  [ -n "$target_ref" ] || target_ref="$local_ref"
  branch_name="${target_ref#refs/heads/}"
  if [[ "$branch_name" =~ $PROTECTED_BRANCHES ]]; then
    if [ "$local_sha" = "$ZERO" ]; then
      echo "🚫 Deleting the protected branch '$branch_name' on the remote is blocked."
    else
      echo "🚫 Direct push to protected branch '$branch_name' is blocked. Use a PR/MR."
    fi
    exit 1
  fi

  # Deletion of a non-protected branch: there is no new content to check.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    LOGOPTS+=("${remote_sha}..${local_sha}")
    BASES+=("$remote_sha")
    TIPS+=("$local_sha")
  else
    # New branch: what's new is whatever is not in ANY remote.
    LOGOPTS+=("$local_sha --not --remotes")
    first_new="$(git rev-list --reverse "$local_sha" --not --remotes 2>/dev/null | head -1)"
    if [ -n "$first_new" ] && git rev-parse --verify --quiet "${first_new}^" >/dev/null 2>&1; then
      BASES+=("${first_new}^")
    elif [ -n "$first_new" ]; then
      BASES+=("$EMPTY_TREE")
    else
      BASES+=("$local_sha")
    fi
    TIPS+=("$local_sha")
  fi
done < "$STDIN_FILE"

NOTHING_NEW=0
[ "${#TIPS[@]}" -eq 0 ] && NOTHING_NEW=1

DIFF_FILES_FILE="$TMPD/files"
COMMITS_FILE="$TMPD/commits"
: > "$DIFF_FILES_FILE"
: > "$COMMITS_FILE"

if [ "$NOTHING_NEW" = "0" ]; then
  i=0
  while [ "$i" -lt "${#TIPS[@]}" ]; do
    # --diff-filter=ACMR excludes deletions: no point linting a file that no longer exists.
    git diff --name-only --diff-filter=ACMR "${BASES[$i]}" "${TIPS[$i]}" 2>/dev/null >> "$DIFF_FILES_FILE"
    # shellcheck disable=SC2086
    git rev-list ${LOGOPTS[$i]} 2>/dev/null >> "$COMMITS_FILE"
    i=$((i + 1))
  done
  sort -u "$DIFF_FILES_FILE" > "$TMPD/f2" && mv "$TMPD/f2" "$DIFF_FILES_FILE"
  sort -u "$COMMITS_FILE" > "$TMPD/c2" && mv "$TMPD/c2" "$COMMITS_FILE"
  note "$(wc -l < "$COMMITS_FILE" | tr -d ' ') commit(s) and $(wc -l < "$DIFF_FILES_FILE" | tr -d ' ') file(s) in this push. Lint/test scope: $QG_SCOPE"
fi

# Prints the pushed files that match any of the given globs.
changed_files() {
  local f pat
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    for pat in "$@"; do
      case "$f" in
        $pat) printf '%s\n' "$f"; break ;;
      esac
    done
  done < "$DIFF_FILES_FILE"
}

# ---------- [1/4] Security and secret scanning ----------
echo ""
echo "🔒 [1/4] Checking for secrets in the commits being pushed..."
if skipped gitleaks; then
  warn "Security and Secrets: skipped by QG_SKIP"
elif [ "$NOTHING_NEW" = "1" ]; then
  note "No new commits, skipping."
elif ! command -v gitleaks >/dev/null 2>&1; then
  warn "gitleaks is not installed, skipping the scan (brew install gitleaks)."
else
  GL_SUB="detect"
  gitleaks git --help >/dev/null 2>&1 && GL_SUB="git"
  GL_CFG=()
  [ -f "$REPO_ROOT/.gitleaks.toml" ] && GL_CFG=(--config "$REPO_ROOT/.gitleaks.toml")

  GL_OK=1
  i=0
  while [ "$i" -lt "${#LOGOPTS[@]}" ]; do
    log="$TMPD/gitleaks-$i.log"
    rc=0
    if [ "$GL_SUB" = "git" ]; then
      run_to "$QG_TIMEOUT" gitleaks git "$REPO_ROOT" ${GL_CFG+"${GL_CFG[@]}"} \
        --log-opts="${LOGOPTS[$i]}" --no-banner -v --exit-code 1 > "$log" 2>&1 || rc=$?
    else
      run_to "$QG_TIMEOUT" gitleaks detect --source "$REPO_ROOT" ${GL_CFG+"${GL_CFG[@]}"} \
        --log-opts="${LOGOPTS[$i]}" --no-banner -v --exit-code 1 > "$log" 2>&1 || rc=$?
    fi
    if [ "$rc" != "0" ]; then
      GL_OK=0
      cat "$log"
    fi
    i=$((i + 1))
  done

  if [ "$GL_OK" = "1" ]; then
    pass "Security and Secrets"
  else
    note "If these are false positives, add an allowlist entry in the repo's .gitleaks.toml."
    fail "Security and Secrets"
  fi
fi

# ---------- [2/4] Commit policies ----------
echo ""
echo "📝 [2/4] Checking commit policies..."
if skipped commits; then
  warn "Git Policies: skipped by QG_SKIP"
elif [ "$NOTHING_NEW" = "1" ]; then
  note "No new commits, skipping."
else
  COMMITS_OK=1
  while IFS= read -r sha; do
    [ -n "$sha" ] || continue
    subject="$(git log -1 --format=%s "$sha")"
    body="$(git log -1 --format=%B "$sha")"

    if [ -z "$(printf '%s' "$body" | tr -d '[:space:]')" ]; then
      echo "   ✘ ${sha:0:8} has an empty message."
      COMMITS_OK=0
      continue
    fi

    case "$subject" in
      fixup!*|squash!*|amend!*)
        echo "   ✘ ${sha:0:8} is an unapplied '$subject' commit. Run 'git rebase -i --autosquash' before pushing."
        COMMITS_OK=0
        continue
        ;;
    esac

    if [ "${#subject}" -gt 100 ]; then
      warn "${sha:0:8} has a ${#subject}-character subject (recommended: <= 72)."
    fi

    if [ "$QG_COMMIT_STYLE" = "conventional" ]; then
      if ! printf '%s' "$subject" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+'; then
        echo "   ✘ ${sha:0:8} does not follow Conventional Commits: '$subject'"
        COMMITS_OK=0
      fi
    fi
  done < "$COMMITS_FILE"

  if [ "$COMMITS_OK" = "1" ]; then
    pass "Git Policies"
  else
    fail "Git Policies"
  fi
fi

# ---------- [3/4] Linters and static analysis ----------
echo ""
echo "🔍 [3/4] Running static analysis and linters..."
if skipped lint; then
  warn "Linters and Static Analysis: skipped by QG_SKIP"
else
  LINT_OK=1
  LINT_RAN=0

  # --- JS / TS ---
  if [ -f "$REPO_ROOT/package.json" ]; then
    HAS_LINT_SCRIPT=0
    if command -v node >/dev/null 2>&1 && \
       node -e "const p=require('$REPO_ROOT/package.json'); process.exit(p.scripts && p.scripts.lint ? 0 : 1)" 2>/dev/null; then
      HAS_LINT_SCRIPT=1
    fi

    JS_FILES=()
    if [ "$QG_SCOPE" = "changed" ] && [ "$NOTHING_NEW" = "0" ]; then
      while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] && JS_FILES+=("$f")
      done < <(changed_files '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.vue' '*.svelte')
    fi

    if [ "$QG_SCOPE" = "changed" ] && [ -x "$REPO_ROOT/node_modules/.bin/eslint" ]; then
      if [ "${#JS_FILES[@]}" -gt 0 ]; then
        LINT_RAN=1
        note "eslint on ${#JS_FILES[@]} file(s) from the push"
        run_to "$QG_TIMEOUT" "$REPO_ROOT/node_modules/.bin/eslint" "${JS_FILES[@]}" || LINT_OK=0
      else
        note "No JS/TS files in the push, skipping eslint."
      fi
    elif [ "$HAS_LINT_SCRIPT" = "1" ] && command -v npm >/dev/null 2>&1; then
      LINT_RAN=1
      [ "$QG_SCOPE" = "changed" ] && note "No local eslint to scope down to; running the full 'npm run lint'."
      run_to "$QG_TIMEOUT" npm run lint || LINT_OK=0
    fi
  fi

  # --- Python ---
  if [ -f "$REPO_ROOT/pyproject.toml" ] || [ -f "$REPO_ROOT/requirements.txt" ] || ls "$REPO_ROOT"/*.py >/dev/null 2>&1; then
    RUFF_EXE=""
    if command -v ruff >/dev/null 2>&1; then
      RUFF_EXE="ruff"
    elif [ -x "$REPO_ROOT/.venv/bin/ruff" ]; then
      RUFF_EXE="$REPO_ROOT/.venv/bin/ruff"
    elif command -v uv >/dev/null 2>&1; then
      RUFF_EXE="uv run --with ruff ruff"
    fi

    if [ -n "$RUFF_EXE" ]; then
      PY_FILES=()
      if [ "$QG_SCOPE" = "changed" ] && [ "$NOTHING_NEW" = "0" ]; then
        while IFS= read -r f; do
          [ -n "$f" ] && [ -f "$f" ] && PY_FILES+=("$f")
        done < <(changed_files '*.py' '*.pyi')
      fi

      if [ "$QG_SCOPE" = "changed" ]; then
        if [ "${#PY_FILES[@]}" -gt 0 ]; then
          LINT_RAN=1
          note "ruff on ${#PY_FILES[@]} file(s) from the push"
          run_to "$QG_TIMEOUT" $RUFF_EXE check "${PY_FILES[@]}" || LINT_OK=0
        else
          note "No Python files in the push, skipping ruff."
        fi
      else
        LINT_RAN=1
        run_to "$QG_TIMEOUT" $RUFF_EXE check . || LINT_OK=0
      fi
    fi
  fi

  # --- Go ---
  if [ -f "$REPO_ROOT/go.mod" ] && command -v go >/dev/null 2>&1; then
    LINT_RAN=1
    note "go vet on the repository"
    run_to "$QG_TIMEOUT" go vet ./... || LINT_OK=0
  fi

  # --- Rust ---
  if [ -f "$REPO_ROOT/Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
    LINT_RAN=1
    note "cargo clippy"
    run_to "$QG_TIMEOUT" cargo clippy -- -D warnings || LINT_OK=0
  fi

  # --- Flutter / Dart ---
  if [ -f "$REPO_ROOT/pubspec.yaml" ]; then
    if command -v flutter >/dev/null 2>&1; then
      LINT_RAN=1
      note "flutter analyze"
      run_to "$QG_TIMEOUT" flutter analyze || LINT_OK=0
    elif command -v dart >/dev/null 2>&1; then
      LINT_RAN=1
      note "dart analyze"
      run_to "$QG_TIMEOUT" dart analyze || LINT_OK=0
    fi
  fi

  # --- PHP ---
  if [ -f "$REPO_ROOT/composer.json" ]; then
    PHP_FILES=()
    while IFS= read -r f; do
      [ -n "$f" ] && [ -f "$f" ] && PHP_FILES+=("$f")
    done < <(changed_files '*.php')

    if [ -f "$REPO_ROOT/vendor/bin/phpcs" ]; then
      if [ "$QG_SCOPE" = "changed" ] && [ "$NOTHING_NEW" = "0" ]; then
        if [ "${#PHP_FILES[@]}" -gt 0 ]; then
          LINT_RAN=1
          note "phpcs on ${#PHP_FILES[@]} file(s) from the push"
          run_to "$QG_TIMEOUT" "$REPO_ROOT/vendor/bin/phpcs" "${PHP_FILES[@]}" || LINT_OK=0
        else
          note "No PHP files in the push, skipping phpcs."
        fi
      else
        LINT_RAN=1
        run_to "$QG_TIMEOUT" "$REPO_ROOT/vendor/bin/phpcs" || LINT_OK=0
      fi
    elif command -v php >/dev/null 2>&1 && [ "${#PHP_FILES[@]}" -gt 0 ]; then
      LINT_RAN=1
      note "php -l on ${#PHP_FILES[@]} file(s) from the push"
      for f in "${PHP_FILES[@]}"; do
        php -l "$f" >/dev/null || LINT_OK=0
      done
    fi
  fi

  if [ "$LINT_RAN" = "0" ]; then
    note "No applicable linters detected; skipping."
    pass "Linters and Static Analysis"
  elif [ "$LINT_OK" = "1" ]; then
    pass "Linters and Static Analysis"
  else
    fail "Linters and Static Analysis"
  fi
fi

# ---------- [4/4] Test suites ----------
echo ""
echo "🧪 [4/4] Running test suites..."
if skipped tests; then
  warn "Test Suites: skipped by QG_SKIP"
else
  TESTS_OK=1
  RAN_ANY=0
  SCOPED_TESTS=0
  [ "$QG_SCOPE" = "changed" ] && [ "$NOTHING_NEW" = "0" ] && SCOPED_TESTS=1

  # --- JS / TS ---
  if [ -f "$REPO_ROOT/package.json" ] && command -v npm >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then
    if node -e "const p=require('$REPO_ROOT/package.json'); process.exit(p.scripts && p.scripts.test ? 0 : 1)" 2>/dev/null; then
      TEST_SCRIPT="$(node -e "const p=require('$REPO_ROOT/package.json'); process.stdout.write(String(p.scripts.test||''))" 2>/dev/null)"

      JS_FILES=()
      if [ "$SCOPED_TESTS" = "1" ]; then
        while IFS= read -r f; do
          [ -n "$f" ] && [ -f "$f" ] && JS_FILES+=("$f")
        done < <(changed_files '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.vue' '*.svelte')
      fi

      RUNNER=""
      case "$TEST_SCRIPT" in
        *vitest*) [ -x "$REPO_ROOT/node_modules/.bin/vitest" ] && RUNNER="vitest" ;;
        *jest*)   [ -x "$REPO_ROOT/node_modules/.bin/jest" ] && RUNNER="jest" ;;
      esac

      if [ "$SCOPED_TESTS" = "1" ] && [ -n "$RUNNER" ] && [ "${#JS_FILES[@]}" -gt 0 ]; then
        RAN_ANY=1
        note "$RUNNER scoped to ${#JS_FILES[@]} file(s) from the push"
        if [ "$RUNNER" = "jest" ]; then
          run_to "$QG_TIMEOUT" "$REPO_ROOT/node_modules/.bin/jest" --ci --watchAll=false \
            --passWithNoTests --findRelatedTests "${JS_FILES[@]}" || TESTS_OK=0
        else
          run_to "$QG_TIMEOUT" "$REPO_ROOT/node_modules/.bin/vitest" related --run \
            --passWithNoTests "${JS_FILES[@]}" || TESTS_OK=0
        fi
      elif [ "$SCOPED_TESTS" = "1" ] && [ -n "$RUNNER" ]; then
        note "No JS/TS files in the push, skipping $RUNNER."
      else
        RAN_ANY=1
        [ "$SCOPED_TESTS" = "1" ] && note "Could not scope down '$TEST_SCRIPT'; running the full suite."
        run_to "$QG_TIMEOUT" npm test || TESTS_OK=0
      fi
    fi
  fi

  # --- Python ---
  PYTEST_EXE=""
  if [ -x "$REPO_ROOT/.venv/bin/pytest" ]; then
    PYTEST_EXE="$REPO_ROOT/.venv/bin/pytest"
  elif command -v pytest >/dev/null 2>&1; then
    PYTEST_EXE="pytest"
  elif command -v uv >/dev/null 2>&1; then
    PYTEST_EXE="uv run pytest"
  fi

  if [ -n "$PYTEST_EXE" ]; then
    PY_TEST_FILES=()
    if [ "$SCOPED_TESTS" = "1" ]; then
      while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] && PY_TEST_FILES+=("$f")
      done < <(changed_files '*test_*.py' '*_test.py' '*/tests/*.py')
    fi

    if [ "$SCOPED_TESTS" = "1" ]; then
      if [ "${#PY_TEST_FILES[@]}" -gt 0 ]; then
        RAN_ANY=1
        note "pytest scoped to ${#PY_TEST_FILES[@]} test file(s) from the push"
        run_to "$QG_TIMEOUT" $PYTEST_EXE -q "${PY_TEST_FILES[@]}"; pt_rc=$?
        if [ "$pt_rc" != "0" ] && [ "$pt_rc" != "5" ]; then TESTS_OK=0; fi
      fi
    elif find "$REPO_ROOT" -maxdepth 6 -not -path "*/node_modules/*" -not -path "*/.venv/*" \
              -not -path "*/vendor/*" -not -path "*/.git/*" \
              \( -iname "test_*.py" -o -iname "*_test.py" \) 2>/dev/null | grep -q .; then
      RAN_ANY=1
      run_to "$QG_TIMEOUT" $PYTEST_EXE -q; pt_rc=$?
      if [ "$pt_rc" != "0" ] && [ "$pt_rc" != "5" ]; then TESTS_OK=0; fi
    fi
  fi

  # --- Go Tests ---
  if [ -f "$REPO_ROOT/go.mod" ] && command -v go >/dev/null 2>&1; then
    RAN_ANY=1
    note "go test ./..."
    run_to "$QG_TIMEOUT" go test ./... || TESTS_OK=0
  fi

  # --- Rust Tests ---
  if [ -f "$REPO_ROOT/Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
    RAN_ANY=1
    note "cargo test"
    run_to "$QG_TIMEOUT" cargo test || TESTS_OK=0
  fi

  # --- Flutter / Dart Tests ---
  if [ -f "$REPO_ROOT/pubspec.yaml" ]; then
    if command -v flutter >/dev/null 2>&1; then
      RAN_ANY=1
      note "flutter test"
      run_to "$QG_TIMEOUT" flutter test || TESTS_OK=0
    elif command -v dart >/dev/null 2>&1; then
      RAN_ANY=1
      note "dart test"
      run_to "$QG_TIMEOUT" dart test || TESTS_OK=0
    fi
  fi

  # --- PHP ---
  if [ -f "$REPO_ROOT/composer.json" ]; then
    if [ -f "$REPO_ROOT/vendor/bin/phpunit" ]; then
      PHP_TEST_FILES=()
      if [ "$SCOPED_TESTS" = "1" ]; then
        while IFS= read -r f; do
          [ -n "$f" ] && [ -f "$f" ] && PHP_TEST_FILES+=("$f")
        done < <(changed_files '*Test.php' '*/tests/*.php' '*/Tests/*.php')
      fi

      if [ "$SCOPED_TESTS" = "1" ]; then
        if [ "${#PHP_TEST_FILES[@]}" -gt 0 ]; then
          RAN_ANY=1
          note "phpunit scoped to ${#PHP_TEST_FILES[@]} test file(s) from the push"
          run_to "$QG_TIMEOUT" "$REPO_ROOT/vendor/bin/phpunit" "${PHP_TEST_FILES[@]}" || TESTS_OK=0
        fi
      else
        RAN_ANY=1
        run_to "$QG_TIMEOUT" "$REPO_ROOT/vendor/bin/phpunit" || TESTS_OK=0
      fi
    elif command -v composer >/dev/null 2>&1 && grep -q '"test"' "$REPO_ROOT/composer.json" 2>/dev/null; then
      RAN_ANY=1
      run_to "$QG_TIMEOUT" composer test || TESTS_OK=0
    fi
  fi

  # --- JVM (not scoped: mvn/gradle don't expose a reliable "just these tests") ---
  if [ -f "$REPO_ROOT/pom.xml" ]; then
    if command -v mvn >/dev/null 2>&1; then
      RAN_ANY=1
      [ "$SCOPED_TESTS" = "1" ] && note "Maven cannot be reliably scoped down; running the full suite."
      run_to "$QG_TIMEOUT" mvn -q -B test || TESTS_OK=0
    else
      warn "pom.xml is present but 'mvn' is not installed; skipping Maven tests."
    fi
  fi

  if [ -f "$REPO_ROOT/build.gradle" ] || [ -f "$REPO_ROOT/build.gradle.kts" ]; then
    if [ -x "$REPO_ROOT/gradlew" ]; then
      RAN_ANY=1
      [ "$SCOPED_TESTS" = "1" ] && note "Gradle cannot be reliably scoped down; running the full suite."
      run_to "$QG_TIMEOUT" "$REPO_ROOT/gradlew" test || TESTS_OK=0
    elif command -v gradle >/dev/null 2>&1; then
      RAN_ANY=1
      run_to "$QG_TIMEOUT" gradle test || TESTS_OK=0
    else
      warn "build.gradle is present but neither ./gradlew nor 'gradle' is installed; skipping tests."
    fi
  fi

  if [ "$RAN_ANY" = "0" ]; then
    note "No test suites were run for this stack; skipping."
    pass "Test Suites"
  elif [ "$TESTS_OK" = "1" ]; then
    pass "Test Suites"
  else
    fail "Test Suites"
  fi
fi

echo ""
if [ "$FAILED" = "1" ]; then
  echo "🛑 Quality Gate failed. Push canceled. Failing checks:"
  printf '%s' "$FAILED_STEPS"
  echo ""
  echo "To skip a specific check (not the whole gate):"
  echo "  QG_SKIP=gitleaks git push          # gitleaks,commits,lint,tests"
  echo "To scope lint and tests to the files in the push:"
  echo "  QG_SCOPE=changed git push"
  exit 1
fi

echo "🚀 All good. Proceeding with git push..."
exit 0
