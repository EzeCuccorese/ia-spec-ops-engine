#!/usr/bin/env bash
# Workspace Quality Gate pre-push hook
# Registered as a Git config-based hook (never core.hooksPath):
#   git config [--global] hook.workspace-gate.event pre-push
#   git config [--global] hook.workspace-gate.command <path-to-this-script>
# Git runs it first and the repository's own pre-push hook (Husky, .git/hooks) last.
#
# Environment variables:
#   QG_SCOPE=all|changed        Scope of linters and tests (default: all)
#   QG_SKIP=a,b,c               Skip checks: gitleaks,commits,lint,design,tests,all
#                               (per repo: git config workspace.skip tests; the variable wins,
#                               QG_SKIP=none forces every check for one push)
#   QG_TIMEOUT=900              Timeout in seconds per step
#   QG_COMMIT_STYLE=conventional  Require Conventional Commits in messages
#                               (per repo: git config workspace.commitStyle conventional)
#   QG_PROTECTED="^(main)$"     Regex of protected branches (override)
#   QG_OUTPUT=errors|verbose    Hide successful output (default: errors)
set -uo pipefail

QG_SCOPE="${QG_SCOPE:-all}"
# QG_SKIP wins when defined (even empty). Otherwise the repo default applies; it lives in the
# shared git config, so every worktree of the repo gets it.
if [ "${QG_SKIP+x}" = "x" ]; then
  QG_SKIP_SOURCE="QG_SKIP"
else
  QG_SKIP="$(git config --get workspace.skip 2>/dev/null || true)"
  QG_SKIP_SOURCE="workspace.skip (repo config)"
fi
QG_TIMEOUT="${QG_TIMEOUT:-900}"
QG_COMMIT_STYLE="${QG_COMMIT_STYLE:-$(git config --get workspace.commitStyle 2>/dev/null || true)}"
QG_OUTPUT="${QG_OUTPUT:-errors}"
PROTECTED_BRANCHES="${QG_PROTECTED:-^(main|master|develop|staging)\$}"

ZERO="0000000000000000000000000000000000000000"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

# Prevents jest/vitest/etc from starting in watch mode and hanging the push forever.
export CI=1

echo "[Quality Gate Pre-Push Hook] Checking quality and security before sending changes..."

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || REPO_ROOT=""
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi
cd "$REPO_ROOT" || exit 1
# Git exports repository-local variables to hooks. They would otherwise leak
# into test subprocesses that create or inspect a different temporary repo.
unset $(git rev-parse --local-env-vars)


FAILED=0
FAILED_STEPS=""
fail() { echo "✘ $1: FAIL"; FAILED=1; FAILED_STEPS="${FAILED_STEPS}  - $1"$'\n'; }
pass() { echo "✔ $1: PASS"; }
warn() { echo "⚠  $1"; }
note() { echo "   $1"; }

# Prints the bin dir of the newest nvm-installed Node for a version spec ("20",
# "v20.1.0"); a non-numeric spec ("lts/*", "node") takes the newest installed.
nvm_node_bin() {
  local spec="${1#v}" root="${NVM_DIR:-$HOME/.nvm}/versions/node" major pattern dir
  [ -d "$root" ] || return 0
  major="${spec%%.*}"
  case "$major" in
    ''|*[!0-9]*) pattern="v*" ;;
    *) pattern="v${major}.*" ;;
  esac
  dir="$(ls -d "$root"/$pattern 2>/dev/null | sort -V | tail -n 1)"
  [ -n "$dir" ] && [ -x "$dir/bin/node" ] && echo "$dir/bin"
  return 0
}

# Hooks launched from an IDE or a desktop Git client do not get the login shell's
# PATH, so the per-user tool directories are appended (the push's own PATH wins).
qg_extend_path() {
  local d
  for d in "$HOME/.local/bin" "/opt/homebrew/bin" "/usr/local/bin" "$HOME/.cargo/bin" \
           "$HOME/go/bin" "$HOME/.sdkman/candidates/maven/current/bin" \
           "$HOME/.sdkman/candidates/gradle/current/bin" "$HOME/.pub-cache/bin" \
           "$HOME/fvm/default/bin"; do
    [ -d "$d" ] || continue
    case ":$PATH:" in
      *":$d:"*) ;;
      *) PATH="$PATH:$d" ;;
    esac
  done
  if ! command -v node >/dev/null 2>&1; then
    local nvm_bin
    nvm_bin="$(nvm_node_bin "$(cat "${NVM_DIR:-$HOME/.nvm}/alias/default" 2>/dev/null)")"
    [ -n "$nvm_bin" ] && PATH="$PATH:$nvm_bin"
  fi
  export PATH
}

# Says why a stack cannot be checked in this checkout and what to run.
env_missing() {
  warn "$1: the project's dependencies are not installed in this checkout (a new worktree?). Run: $2"
}

# Envs that Poetry, Pipenv and PDM keep outside the repo, one path per line.
# `poetry env info -p` fails when the env was built with a Python other than the
# one Poetry picks now, so the project's listed envs are tried too.
python_manager_envs() {
  if [ -f "$REPO_ROOT/poetry.lock" ] && command -v poetry >/dev/null 2>&1; then
    { poetry env info -p 2>/dev/null; echo; poetry env list --full-path 2>/dev/null; } |
      sed 's/ (Activated)$//'
  fi
  if [ -f "$REPO_ROOT/Pipfile.lock" ] && command -v pipenv >/dev/null 2>&1; then
    pipenv --venv 2>/dev/null
  fi
  if [ -f "$REPO_ROOT/pdm.lock" ] && command -v pdm >/dev/null 2>&1; then
    local py
    py="$(pdm info --python 2>/dev/null)"
    [ -n "$py" ] && dirname "$(dirname "$py")"
  fi
  return 0
}

# How to run a Python tool from the project's own environment: .venv/venv, a uv
# project, then a Poetry/Pipenv/PDM env. Prints nothing when there is none here.
python_project_tool() {
  local tool="$1" dir
  for dir in "$REPO_ROOT/.venv" "$REPO_ROOT/venv"; do
    if [ -x "$dir/bin/$tool" ]; then
      echo "$dir/bin/$tool"
      return 0
    fi
  done
  if [ -f "$REPO_ROOT/uv.lock" ] && command -v uv >/dev/null 2>&1; then
    echo "uv run $tool"
    return 0
  fi
  while IFS= read -r dir; do
    if [ -n "$dir" ] && [ -x "$dir/bin/$tool" ]; then
      echo "$dir/bin/$tool"
      return 0
    fi
  done < <(python_manager_envs)
  return 0
}

# The ruff version a Poetry/PDM/Pipenv lockfile pins, so a checkout without its
# env still lints with that version instead of a global one.
ruff_locked_version() {
  local lock
  for lock in poetry.lock pdm.lock; do
    if [ -f "$REPO_ROOT/$lock" ]; then
      awk '/^name = "ruff"$/ { found = 1; next } found && /^version = / { gsub(/"/, "", $3); print $3; exit }' \
        "$REPO_ROOT/$lock"
      return 0
    fi
  done
  if [ -f "$REPO_ROOT/Pipfile.lock" ]; then
    grep -A4 '"ruff": {' "$REPO_ROOT/Pipfile.lock" | grep -oE '"version": "==[^"]+"' | head -n 1 |
      sed -E 's/.*==([^"]+)"/\1/'
  fi
  return 0
}

# The command that installs the project's Python environment, from its lockfile.
python_install_cmd() {
  if [ -f "$REPO_ROOT/uv.lock" ]; then echo "uv sync"
  elif [ -f "$REPO_ROOT/poetry.lock" ]; then echo "poetry install"
  elif [ -f "$REPO_ROOT/Pipfile.lock" ]; then echo "pipenv install --dev"
  elif [ -f "$REPO_ROOT/pdm.lock" ]; then echo "pdm install"
  elif [ -f "$REPO_ROOT/requirements.txt" ]; then echo "pip install -r requirements.txt"
  fi
  return 0
}

# A ModuleNotFoundError is an environment problem, not a failing test: say so
# instead of letting it read like a broken suite. Reads the last command's log.
explain_missing_module() {
  local log="$TMPD/command-$RUN_SEQUENCE.log" missing
  [ -f "$log" ] || return 0
  missing="$(grep -oE "No module named '[^']+'" "$log" | head -n 1)"
  [ -n "$missing" ] || return 0
  warn "That is an environment problem ($missing), not a failing test."
  if [ "$1" = "pytest" ]; then
    note "A global pytest ran, and it lacks the project's dependencies."
  else
    note "The environment is missing a dependency (stale after a lockfile change?)."
  fi
  [ -n "$(python_install_cmd)" ] && note "Install it: $(python_install_cmd)"
  return 0
}

# The package manager the lockfile asks for, when it is installed (else npm).
js_pm() {
  if [ -f "$REPO_ROOT/pnpm-lock.yaml" ] && command -v pnpm >/dev/null 2>&1; then echo "pnpm"
  elif [ -f "$REPO_ROOT/yarn.lock" ] && command -v yarn >/dev/null 2>&1; then echo "yarn"
  elif { [ -f "$REPO_ROOT/bun.lock" ] || [ -f "$REPO_ROOT/bun.lockb" ]; } && command -v bun >/dev/null 2>&1; then echo "bun"
  else echo "npm"
  fi
}

# Prints the install command when package.json declares dependencies that this
# checkout has not installed (a new worktree has no node_modules).
js_install_hint() {
  { [ -d "$REPO_ROOT/node_modules" ] || [ -f "$REPO_ROOT/.pnp.cjs" ]; } && return 0
  node -e "const p=require('$REPO_ROOT/package.json'); process.exit(Object.keys({...p.dependencies, ...p.devDependencies}).length ? 0 : 1)" 2>/dev/null || return 0
  local pm
  pm="$(js_pm)"
  if [ "$pm" = "npm" ] && [ -f "$REPO_ROOT/package-lock.json" ]; then echo "npm ci"
  else echo "$pm install"
  fi
}

# Puts the Node the repo pins (.nvmrc / .node-version) first on PATH when nvm
# has it; warns when only another major is reachable.
use_pinned_node() {
  local pin_file="" f pin want have bin
  for f in .nvmrc .node-version; do
    if [ -f "$REPO_ROOT/$f" ]; then pin_file="$f"; break; fi
  done
  [ -n "$pin_file" ] || return 0
  pin="$(tr -d '[:space:]' < "$REPO_ROOT/$pin_file")"
  want="${pin#v}"; want="${want%%.*}"
  case "$want" in ''|*[!0-9]*) return 0 ;; esac
  have="$(node -v 2>/dev/null)"; have="${have#v}"; have="${have%%.*}"
  [ "$have" = "$want" ] && return 0
  bin="$(nvm_node_bin "$want")"
  if [ -n "$bin" ]; then
    PATH="$bin:$PATH"; export PATH
    note "Using Node $want from nvm ($pin_file pins it)"
  else
    warn "$pin_file pins Node $want but the reachable node is ${have:-missing}; results may differ from CI."
  fi
  return 0
}

# Prints the install command when composer.json declares dependencies and this
# checkout has no vendor/ (a new worktree).
php_install_hint() {
  [ -d "$REPO_ROOT/vendor" ] && return 0
  grep -qE '"require(-dev)?"[[:space:]]*:[[:space:]]*\{[[:space:]]*"' "$REPO_ROOT/composer.json" 2>/dev/null &&
    echo "composer install"
  return 0
}

# The Flutter SDK tool (flutter|dart) the repo pins with FVM, else the global one.
flutter_tool() {
  local tool="$1"
  if [ -f "$REPO_ROOT/.fvmrc" ] || [ -f "$REPO_ROOT/.fvm/fvm_config.json" ]; then
    if [ -x "$REPO_ROOT/.fvm/flutter_sdk/bin/$tool" ]; then
      echo "$REPO_ROOT/.fvm/flutter_sdk/bin/$tool"
      return 0
    fi
    if command -v fvm >/dev/null 2>&1; then
      echo "fvm $tool"
      return 0
    fi
  fi
  command -v "$tool" >/dev/null 2>&1 && echo "$tool"
  return 0
}

qg_extend_path

case "$QG_OUTPUT" in
  errors|verbose) ;;
  *)
    warn "QG_OUTPUT='$QG_OUTPUT' is not valid; using 'errors'."
    QG_OUTPUT="errors"
    ;;
esac

skipped() {
  case ",${QG_SKIP}," in
    *,all,*) return 0 ;;
    *",$1,"*) return 0 ;;
  esac
  return 1
}

# Watchdog: runs the command in its own process group and, on timeout or interrupt, signals
# the WHOLE group (TERM, then KILL after a grace period), so children such as test workers
# never outlive the gate. Exit 124 on timeout.
# --- watchdog:start ---
QG_WATCHDOG='
use strict; use warnings; use POSIX ();
my $secs = shift @ARGV;
my $pid = fork();
die "fork: $!" unless defined $pid;
if ($pid == 0) { setpgrp(0, 0); exec { $ARGV[0] } @ARGV or exit 127; }
my $stop = sub {
  my ($code) = @_;
  kill "-TERM", $pid;
  for (1 .. 50) { last unless kill 0, -$pid; select(undef, undef, undef, 0.1); }
  kill "-KILL", $pid;
  waitpid($pid, 0);
  exit $code;
};
$SIG{ALRM} = sub { $stop->(124) };
$SIG{INT}  = sub { $stop->(130) };
$SIG{TERM} = sub { $stop->(143) };
alarm $secs;
waitpid($pid, 0);
my $status = $?;
alarm 0;
kill "-KILL", $pid;  # reap any background leftovers of a command that already exited
exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
'
# --- watchdog:end ---

# Runs "$@" under the watchdog when perl exists, else GNU timeout with a kill fallback.
with_timeout() {
  local secs="$1"; shift
  if command -v perl >/dev/null 2>&1; then
    perl -e "$QG_WATCHDOG" "$secs" "$@"
  elif command -v timeout >/dev/null 2>&1; then
    timeout --kill-after=5 "$secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout --kill-after=5 "$secs" "$@"
  else
    "$@"
  fi
}

# Saves the full transcript of a failed command outside the working tree.
persist_failure_log() {
  local rc="$1" command_log="$2"; shift 2
  if ! mkdir -p "$FAILURE_LOG_DIR" 2>/dev/null; then
    warn "Could not create the full log directory: $FAILURE_LOG_DIR"
    return 0
  fi
  if [ "$FAILURE_LOG_READY" = "0" ]; then
    if ! : > "$FAILURE_LOG" 2>/dev/null; then
      warn "Could not write the full log: $FAILURE_LOG"
      return 0
    fi
    chmod 600 "$FAILURE_LOG" 2>/dev/null || true
    FAILURE_LOG_READY=1
  fi
  {
    echo "== Failed command (exit $rc) =="
    printf '%q ' "$@"
    echo ""
    cat "$command_log"
    echo ""
  } >> "$FAILURE_LOG" 2>/dev/null || warn "Could not update: $FAILURE_LOG"
}

show_failed_command() {
  local rc="$1" command_log="$2"; shift 2
  local line_count
  line_count="$(wc -l < "$command_log" | tr -d ' ')"
  echo ""
  echo "   Failed command (exit code $rc):"
  printf '   > '
  printf '%q ' "$@"
  echo ""
  if [ "$line_count" -le 200 ]; then
    cat "$command_log"
  else
    head -n 80 "$command_log"
    echo "   ... output truncated: $line_count lines total ..."
    tail -n 120 "$command_log"
  fi
  persist_failure_log "$rc" "$command_log" "$@"
  if [ "$FAILURE_LOG_READY" = "1" ]; then
    note "Full log: $FAILURE_LOG"
  fi
}

# Runs a command with a time limit, so no hung tool can block the push.
# In errors mode it captures stdout+stderr and only shows them if the command fails.
run_to() {
  local secs="$1"; shift
  local rc=0 command_log=""
  RUN_SEQUENCE=$((RUN_SEQUENCE + 1))
  command_log="$TMPD/command-$RUN_SEQUENCE.log"
  if [ "$QG_OUTPUT" = "verbose" ]; then
    with_timeout "$secs" "$@"; rc=$?
  else
    with_timeout "$secs" "$@" > "$command_log" 2>&1; rc=$?
    if [ "$rc" = "0" ]; then
      rm -f "$command_log"
    else
      show_failed_command "$rc" "$command_log" "$@"
    fi
  fi
  if [ "$rc" = "124" ]; then
    echo "   ⏱  '$1' exceeded ${secs}s and was aborted (raise QG_TIMEOUT if that is expected)."
  fi
  return $rc
}

TMPD="$(mktemp -d "${TMPDIR:-/tmp}/qg.XXXXXX")" || exit 1
trap 'rm -rf "$TMPD"' EXIT INT TERM
RUN_SEQUENCE=0
FAILURE_LOG_READY=0
FAILURE_LOG_DIR="$(git rev-parse --git-path workspace/quality-gate 2>/dev/null || printf '%s' "$TMPD")"
FAILURE_LOG="$FAILURE_LOG_DIR/latest.log"

# --- stdin -------------------------------------------------------------------
# Git sends one line per ref: "local_ref local_sha remote_ref remote_sha".
# We save it to a file so it can be re-fed to the repo's own hook.
STDIN_FILE="$TMPD/stdin"
cat > "$STDIN_FILE"

LOGOPTS=()   # range in "git log" format for gitleaks / rev-list
BASES=()     # base commit for the diff
TIPS=()      # tip commit for the diff

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref}${local_sha}${remote_ref}${remote_sha}" ] || continue

  # The protected branch is the DESTINATION one (remote_ref), not the local one:
  # otherwise "git push origin feature:main" would slip through unchecked.
  target_ref="$remote_ref"
  [ -n "$target_ref" ] || target_ref="$local_ref"
  branch_name="${target_ref#refs/heads/}"
  if [[ "$branch_name" =~ $PROTECTED_BRANCHES ]]; then
    if [ "$local_sha" = "$ZERO" ]; then
      echo "🚫 Deleting the protected branch '$branch_name' on the remote is blocked."
    else
      echo "🚫 Direct push to protected branch '$branch_name' is blocked. Use a PR/MR."
    fi
    exit 1
  fi

  # Deletion of a non-protected branch: there is no new content to check.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    LOGOPTS+=("${remote_sha}..${local_sha}")
    BASES+=("$remote_sha")
    TIPS+=("$local_sha")
  else
    # New branch: what's new is whatever is not in ANY remote.
    LOGOPTS+=("$local_sha --not --remotes")
    first_new="$(git rev-list --reverse "$local_sha" --not --remotes 2>/dev/null | head -1)"
    if [ -n "$first_new" ] && git rev-parse --verify --quiet "${first_new}^" >/dev/null 2>&1; then
      BASES+=("${first_new}^")
    elif [ -n "$first_new" ]; then
      BASES+=("$EMPTY_TREE")
    else
      BASES+=("$local_sha")
    fi
    TIPS+=("$local_sha")
  fi
done < "$STDIN_FILE"

NOTHING_NEW=0
[ "${#TIPS[@]}" -eq 0 ] && NOTHING_NEW=1

DIFF_FILES_FILE="$TMPD/files"
COMMITS_FILE="$TMPD/commits"
: > "$DIFF_FILES_FILE"
: > "$COMMITS_FILE"

if [ "$NOTHING_NEW" = "0" ]; then
  i=0
  while [ "$i" -lt "${#TIPS[@]}" ]; do
    # --diff-filter=ACMR excludes deletions: no point linting a file that no longer exists.
    git diff --name-only --diff-filter=ACMR "${BASES[$i]}" "${TIPS[$i]}" 2>/dev/null >> "$DIFF_FILES_FILE"
    # shellcheck disable=SC2086
    git rev-list ${LOGOPTS[$i]} 2>/dev/null >> "$COMMITS_FILE"
    i=$((i + 1))
  done
  sort -u "$DIFF_FILES_FILE" > "$TMPD/f2" && mv "$TMPD/f2" "$DIFF_FILES_FILE"
  sort -u "$COMMITS_FILE" > "$TMPD/c2" && mv "$TMPD/c2" "$COMMITS_FILE"
  note "$(wc -l < "$COMMITS_FILE" | tr -d ' ') commit(s) and $(wc -l < "$DIFF_FILES_FILE" | tr -d ' ') file(s) in this push. Lint/test scope: $QG_SCOPE"
fi

# Prints the pushed files that match any of the given globs.
changed_files() {
  local f pat
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    for pat in "$@"; do
      case "$f" in
        $pat) printf '%s\n' "$f"; break ;;
      esac
    done
  done < "$DIFF_FILES_FILE"
}

# ---------- [1/5] Security and secret scanning ----------
echo ""
echo "🔒 [1/5] Checking for secrets in the commits being pushed..."
if skipped gitleaks; then
  warn "Security and Secrets: skipped by $QG_SKIP_SOURCE"
elif [ "$NOTHING_NEW" = "1" ]; then
  note "No new commits, skipping."
elif ! command -v gitleaks >/dev/null 2>&1; then
  warn "gitleaks is not installed, skipping the scan (brew install gitleaks)."
else
  GL_SUB="detect"
  gitleaks git --help >/dev/null 2>&1 && GL_SUB="git"
  GL_CFG=()
  [ -f "$REPO_ROOT/.gitleaks.toml" ] && GL_CFG=(--config "$REPO_ROOT/.gitleaks.toml")

  GL_OK=1
  i=0
  while [ "$i" -lt "${#LOGOPTS[@]}" ]; do
    log="$TMPD/gitleaks-$i.log"
    rc=0
    if [ "$GL_SUB" = "git" ]; then
      run_to "$QG_TIMEOUT" gitleaks git "$REPO_ROOT" ${GL_CFG+"${GL_CFG[@]}"} \
        --log-opts="${LOGOPTS[$i]}" --no-banner -v --exit-code 1 > "$log" 2>&1 || rc=$?
    else
      run_to "$QG_TIMEOUT" gitleaks detect --source "$REPO_ROOT" ${GL_CFG+"${GL_CFG[@]}"} \
        --log-opts="${LOGOPTS[$i]}" --no-banner -v --exit-code 1 > "$log" 2>&1 || rc=$?
    fi
    if [ "$rc" != "0" ]; then
      GL_OK=0
      cat "$log"
    fi
    i=$((i + 1))
  done

  if [ "$GL_OK" = "1" ]; then
    pass "Security and Secrets"
  else
    note "If these are false positives, add an allowlist entry in the repo's .gitleaks.toml."
    fail "Security and Secrets"
  fi
fi

# ---------- [2/5] Commit policies ----------
echo ""
echo "📝 [2/5] Checking commit policies..."
if skipped commits; then
  warn "Git Policies: skipped by $QG_SKIP_SOURCE"
elif [ "$NOTHING_NEW" = "1" ]; then
  note "No new commits, skipping."
else
  COMMITS_OK=1
  while IFS= read -r sha; do
    [ -n "$sha" ] || continue
    subject="$(git log -1 --format=%s "$sha")"
    body="$(git log -1 --format=%B "$sha")"

    if [ -z "$(printf '%s' "$body" | tr -d '[:space:]')" ]; then
      echo "   ✘ ${sha:0:8} has an empty message."
      COMMITS_OK=0
      continue
    fi

    case "$subject" in
      fixup!*|squash!*|amend!*)
        echo "   ✘ ${sha:0:8} is an unapplied '$subject' commit. Run 'git rebase -i --autosquash' before pushing."
        COMMITS_OK=0
        continue
        ;;
    esac

    if [ "${#subject}" -gt 100 ]; then
      warn "${sha:0:8} has a ${#subject}-character subject (recommended: <= 72)."
    fi

    if [ "$QG_COMMIT_STYLE" = "conventional" ]; then
      if ! printf '%s' "$subject" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+'; then
        echo "   ✘ ${sha:0:8} does not follow Conventional Commits: '$subject'"
        COMMITS_OK=0
      fi
    fi
  done < "$COMMITS_FILE"

  if [ "$COMMITS_OK" = "1" ]; then
    pass "Git Policies"
  else
    fail "Git Policies"
  fi
fi

# ---------- [3/5] Linters and static analysis ----------
echo ""
echo "🔍 [3/5] Running static analysis and linters..."
if skipped lint; then
  warn "Linters and Static Analysis: skipped by $QG_SKIP_SOURCE"
else
  LINT_OK=1
  LINT_RAN=0

  # --- JS / TS ---
  if [ -f "$REPO_ROOT/package.json" ]; then
    use_pinned_node
    JS_PM="$(js_pm)"
    JS_INSTALL_HINT="$(js_install_hint)"
    HAS_LINT_SCRIPT=0
    if command -v node >/dev/null 2>&1 && \
       node -e "const p=require('$REPO_ROOT/package.json'); process.exit(p.scripts && p.scripts.lint ? 0 : 1)" 2>/dev/null; then
      HAS_LINT_SCRIPT=1
    fi

    JS_FILES=()
    if [ "$QG_SCOPE" = "changed" ] && [ "$NOTHING_NEW" = "0" ]; then
      while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] && JS_FILES+=("$f")
      done < <(changed_files '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.vue' '*.svelte')
    fi

    if [ "$HAS_LINT_SCRIPT" = "1" ] && [ -n "$JS_INSTALL_HINT" ]; then
      LINT_RAN=1
      LINT_OK=0
      env_missing "JS/TS" "$JS_INSTALL_HINT"
    elif [ "$QG_SCOPE" = "changed" ] && [ -x "$REPO_ROOT/node_modules/.bin/eslint" ]; then
      if [ "${#JS_FILES[@]}" -gt 0 ]; then
        LINT_RAN=1
        note "eslint on ${#JS_FILES[@]} file(s) from the push"
        run_to "$QG_TIMEOUT" "$REPO_ROOT/node_modules/.bin/eslint" "${JS_FILES[@]}" || LINT_OK=0
      else
        note "No JS/TS files in the push, skipping eslint."
      fi
    elif [ "$HAS_LINT_SCRIPT" = "1" ] && command -v "$JS_PM" >/dev/null 2>&1; then
      LINT_RAN=1
      [ "$QG_SCOPE" = "changed" ] && note "No local eslint to scope down to; running the full '$JS_PM run lint'."
      run_to "$QG_TIMEOUT" "$JS_PM" run lint || LINT_OK=0
    fi
  fi

  # --- Python ---
  if [ -f "$REPO_ROOT/pyproject.toml" ] || [ -f "$REPO_ROOT/requirements.txt" ] || ls "$REPO_ROOT"/*.py >/dev/null 2>&1; then
    # The project's own environment first: a global ruff may be another version.
    # ruff has no dependencies: without the project's env, run the version its
    # lockfile pins, and only then a global one.
    RUFF_EXE="$(python_project_tool ruff)"
    RUFF_LOCKED="$(ruff_locked_version)"
    if [ -z "$RUFF_EXE" ]; then
      if [ -n "$RUFF_LOCKED" ] && command -v uv >/dev/null 2>&1; then
        RUFF_EXE="uv tool run ruff@$RUFF_LOCKED"
      elif command -v ruff >/dev/null 2>&1; then
        RUFF_EXE="ruff"
      elif command -v uv >/dev/null 2>&1; then
        RUFF_EXE="uv run --with ruff ruff"
      fi
    fi

    if [ -n "$RUFF_EXE" ]; then
      PY_FILES=()
      if [ "$QG_SCOPE" = "changed" ] && [ "$NOTHING_NEW" = "0" ]; then
        while IFS= read -r f; do
          [ -n "$f" ] && [ -f "$f" ] && PY_FILES+=("$f")
        done < <(changed_files '*.py' '*.pyi')
      fi

      if [ "$QG_SCOPE" = "changed" ]; then
        if [ "${#PY_FILES[@]}" -gt 0 ]; then
          LINT_RAN=1
          note "ruff on ${#PY_FILES[@]} file(s) from the push"
          run_to "$QG_TIMEOUT" $RUFF_EXE check "${PY_FILES[@]}" || LINT_OK=0
        else
          note "No Python files in the push, skipping ruff."
        fi
      else
        LINT_RAN=1
        run_to "$QG_TIMEOUT" $RUFF_EXE check . || LINT_OK=0
      fi
    fi
  fi

  # --- Go ---
  if [ -f "$REPO_ROOT/go.mod" ] && command -v go >/dev/null 2>&1; then
    LINT_RAN=1
    note "go vet on the repository"
    run_to "$QG_TIMEOUT" go vet ./... || LINT_OK=0
  fi

  # --- Rust ---
  if [ -f "$REPO_ROOT/Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
    LINT_RAN=1
    note "cargo clippy"
    run_to "$QG_TIMEOUT" cargo clippy -- -D warnings || LINT_OK=0
  fi

  # --- Flutter / Dart ---
  if [ -f "$REPO_ROOT/pubspec.yaml" ]; then
    FLUTTER_EXE="$(flutter_tool flutter)"
    DART_EXE="$(flutter_tool dart)"
    if [ -n "$FLUTTER_EXE" ]; then
      LINT_RAN=1
      note "$FLUTTER_EXE analyze"
      run_to "$QG_TIMEOUT" $FLUTTER_EXE analyze || LINT_OK=0
    elif [ -n "$DART_EXE" ]; then
      LINT_RAN=1
      note "$DART_EXE analyze"
      run_to "$QG_TIMEOUT" $DART_EXE analyze || LINT_OK=0
    fi
  fi

  # --- PHP ---
  if [ -f "$REPO_ROOT/composer.json" ]; then
    PHP_FILES=()
    while IFS= read -r f; do
      [ -n "$f" ] && [ -f "$f" ] && PHP_FILES+=("$f")
    done < <(changed_files '*.php')

    if [ -f "$REPO_ROOT/vendor/bin/phpcs" ]; then
      if [ "$QG_SCOPE" = "changed" ] && [ "$NOTHING_NEW" = "0" ]; then
        if [ "${#PHP_FILES[@]}" -gt 0 ]; then
          LINT_RAN=1
          note "phpcs on ${#PHP_FILES[@]} file(s) from the push"
          run_to "$QG_TIMEOUT" "$REPO_ROOT/vendor/bin/phpcs" "${PHP_FILES[@]}" || LINT_OK=0
        else
          note "No PHP files in the push, skipping phpcs."
        fi
      else
        LINT_RAN=1
        run_to "$QG_TIMEOUT" "$REPO_ROOT/vendor/bin/phpcs" || LINT_OK=0
      fi
    elif command -v php >/dev/null 2>&1 && [ "${#PHP_FILES[@]}" -gt 0 ]; then
      LINT_RAN=1
      note "php -l on ${#PHP_FILES[@]} file(s) from the push"
      for f in "${PHP_FILES[@]}"; do
        php -l "$f" >/dev/null || LINT_OK=0
      done
    fi
  fi

  if [ "$LINT_RAN" = "0" ]; then
    note "No applicable linters detected; skipping."
    pass "Linters and Static Analysis"
  elif [ "$LINT_OK" = "1" ]; then
    pass "Linters and Static Analysis"
  else
    fail "Linters and Static Analysis"
  fi
fi

# ---------- [4/5] Design limits ----------
# Always scoped to the files in this push (regardless of QG_SCOPE): it judges new code.
echo ""
echo "📐 [4/5] Checking design limits on the files in this push..."
if skipped design; then
  warn "Design limits: skipped by $QG_SKIP_SOURCE"
elif [ "$NOTHING_NEW" = "1" ]; then
  note "No new commits, skipping."
elif [ ! -s "$DIFF_FILES_FILE" ]; then
  note "No files in the push, skipping design limits."
elif ! command -v ws >/dev/null 2>&1; then
  warn "Design limits: ws not found, skipped"
elif ! ws design --help >/dev/null 2>&1; then
  warn "Design limits: installed ws has no 'design' command (upgrade workspace), skipped"
else
  if run_to "$QG_TIMEOUT" ws design --dir "$REPO_ROOT" --files-from "$DIFF_FILES_FILE"; then
    pass "Design limits"
  else
    fail "Design limits"
  fi
fi

# ---------- [5/5] Test suites ----------
echo ""
echo "🧪 [5/5] Running test suites..."
if skipped tests; then
  warn "Test Suites: skipped by $QG_SKIP_SOURCE"
else
  TESTS_OK=1
  RAN_ANY=0
  SCOPED_TESTS=0
  [ "$QG_SCOPE" = "changed" ] && [ "$NOTHING_NEW" = "0" ] && SCOPED_TESTS=1

  # --- JS / TS ---
  HAS_TEST_SCRIPT=0
  if [ -f "$REPO_ROOT/package.json" ] && command -v node >/dev/null 2>&1; then
    use_pinned_node
    JS_PM="$(js_pm)"
    JS_INSTALL_HINT="$(js_install_hint)"
    if command -v "$JS_PM" >/dev/null 2>&1 && \
       node -e "const p=require('$REPO_ROOT/package.json'); process.exit(p.scripts && p.scripts.test ? 0 : 1)" 2>/dev/null; then
      HAS_TEST_SCRIPT=1
    fi
  fi
  if [ "$HAS_TEST_SCRIPT" = "1" ]; then
    if [ -n "$JS_INSTALL_HINT" ]; then
      RAN_ANY=1
      TESTS_OK=0
      env_missing "JS/TS" "$JS_INSTALL_HINT"
    else
      TEST_SCRIPT="$(node -e "const p=require('$REPO_ROOT/package.json'); process.stdout.write(String(p.scripts.test||''))" 2>/dev/null)"

      JS_FILES=()
      if [ "$SCOPED_TESTS" = "1" ]; then
        while IFS= read -r f; do
          [ -n "$f" ] && [ -f "$f" ] && JS_FILES+=("$f")
        done < <(changed_files '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.vue' '*.svelte')
      fi

      RUNNER=""
      case "$TEST_SCRIPT" in
        *vitest*) [ -x "$REPO_ROOT/node_modules/.bin/vitest" ] && RUNNER="vitest" ;;
        *jest*)   [ -x "$REPO_ROOT/node_modules/.bin/jest" ] && RUNNER="jest" ;;
      esac

      if [ "$SCOPED_TESTS" = "1" ] && [ -n "$RUNNER" ] && [ "${#JS_FILES[@]}" -gt 0 ]; then
        RAN_ANY=1
        note "$RUNNER scoped to ${#JS_FILES[@]} file(s) from the push"
        if [ "$RUNNER" = "jest" ]; then
          run_to "$QG_TIMEOUT" "$REPO_ROOT/node_modules/.bin/jest" --ci --watchAll=false \
            --passWithNoTests --findRelatedTests "${JS_FILES[@]}" || TESTS_OK=0
        else
          run_to "$QG_TIMEOUT" "$REPO_ROOT/node_modules/.bin/vitest" related --run \
            --passWithNoTests "${JS_FILES[@]}" || TESTS_OK=0
        fi
      elif [ "$SCOPED_TESTS" = "1" ] && [ -n "$RUNNER" ]; then
        note "No JS/TS files in the push, skipping $RUNNER."
      else
        RAN_ANY=1
        [ "$SCOPED_TESTS" = "1" ] && note "Could not scope down '$TEST_SCRIPT'; running the full suite."
        run_to "$QG_TIMEOUT" "$JS_PM" test || TESTS_OK=0
      fi
    fi
  fi

  # --- Python ---
  # The project's own environment first: a global pytest lacks the project's
  # dependencies. A project whose manager (Poetry, Pipenv, PDM) has no env in
  # this checkout is reported as such instead of running a global pytest.
  PYTEST_EXE="$(python_project_tool pytest)"
  PY_ENV_HINT=""
  if [ -z "$PYTEST_EXE" ]; then
    if [ -f "$REPO_ROOT/poetry.lock" ] || [ -f "$REPO_ROOT/Pipfile.lock" ] || [ -f "$REPO_ROOT/pdm.lock" ]; then
      PY_ENV_HINT="$(python_install_cmd)"
    elif command -v pytest >/dev/null 2>&1; then
      PYTEST_EXE="pytest"
    elif command -v uv >/dev/null 2>&1; then
      PYTEST_EXE="uv run pytest"
    fi
  fi

  if [ -n "$PYTEST_EXE" ] || [ -n "$PY_ENV_HINT" ]; then
    PY_TEST_FILES=()
    PY_RUN=0
    if [ "$SCOPED_TESTS" = "1" ]; then
      while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] && PY_TEST_FILES+=("$f")
      done < <(changed_files '*test_*.py' '*_test.py' '*/tests/*.py')
      [ "${#PY_TEST_FILES[@]}" -gt 0 ] && PY_RUN=1
    elif find "$REPO_ROOT" -maxdepth 6 -not -path "*/node_modules/*" -not -path "*/.venv/*" \
              -not -path "*/vendor/*" -not -path "*/.git/*" \
              \( -iname "test_*.py" -o -iname "*_test.py" \) 2>/dev/null | grep -q .; then
      PY_RUN=1
    fi

    if [ "$PY_RUN" = "1" ] && [ -n "$PY_ENV_HINT" ]; then
      RAN_ANY=1
      TESTS_OK=0
      env_missing "Python" "$PY_ENV_HINT"
    elif [ "$PY_RUN" = "1" ]; then
      RAN_ANY=1
      if [ "$SCOPED_TESTS" = "1" ]; then
        note "pytest scoped to ${#PY_TEST_FILES[@]} test file(s) from the push"
        run_to "$QG_TIMEOUT" $PYTEST_EXE -q "${PY_TEST_FILES[@]}"; pt_rc=$?
      else
        run_to "$QG_TIMEOUT" $PYTEST_EXE -q; pt_rc=$?
      fi
      if [ "$pt_rc" != "0" ] && [ "$pt_rc" != "5" ]; then
        TESTS_OK=0
        explain_missing_module "$PYTEST_EXE"
      fi
    fi
  fi

  # --- Go Tests ---
  if [ -f "$REPO_ROOT/go.mod" ] && command -v go >/dev/null 2>&1; then
    RAN_ANY=1
    note "go test ./..."
    run_to "$QG_TIMEOUT" go test ./... || TESTS_OK=0
  fi

  # --- Rust Tests ---
  if [ -f "$REPO_ROOT/Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
    RAN_ANY=1
    note "cargo test"
    run_to "$QG_TIMEOUT" cargo test || TESTS_OK=0
  fi

  # --- Flutter / Dart Tests ---
  if [ -f "$REPO_ROOT/pubspec.yaml" ]; then
    FLUTTER_EXE="$(flutter_tool flutter)"
    DART_EXE="$(flutter_tool dart)"
    if [ -n "$FLUTTER_EXE" ]; then
      RAN_ANY=1
      note "$FLUTTER_EXE test"
      run_to "$QG_TIMEOUT" $FLUTTER_EXE test || TESTS_OK=0
    elif [ -n "$DART_EXE" ]; then
      RAN_ANY=1
      note "$DART_EXE test"
      run_to "$QG_TIMEOUT" $DART_EXE test || TESTS_OK=0
    fi
  fi

  # --- PHP ---
  if [ -f "$REPO_ROOT/composer.json" ]; then
    if [ -f "$REPO_ROOT/vendor/bin/phpunit" ]; then
      PHP_TEST_FILES=()
      if [ "$SCOPED_TESTS" = "1" ]; then
        while IFS= read -r f; do
          [ -n "$f" ] && [ -f "$f" ] && PHP_TEST_FILES+=("$f")
        done < <(changed_files '*Test.php' '*/tests/*.php' '*/Tests/*.php')
      fi

      if [ "$SCOPED_TESTS" = "1" ]; then
        if [ "${#PHP_TEST_FILES[@]}" -gt 0 ]; then
          RAN_ANY=1
          note "phpunit scoped to ${#PHP_TEST_FILES[@]} test file(s) from the push"
          run_to "$QG_TIMEOUT" "$REPO_ROOT/vendor/bin/phpunit" "${PHP_TEST_FILES[@]}" || TESTS_OK=0
        fi
      else
        RAN_ANY=1
        run_to "$QG_TIMEOUT" "$REPO_ROOT/vendor/bin/phpunit" || TESTS_OK=0
      fi
    elif [ -n "$(php_install_hint)" ] && { grep -q '"test"' "$REPO_ROOT/composer.json" 2>/dev/null ||
           [ -f "$REPO_ROOT/phpunit.xml" ] || [ -f "$REPO_ROOT/phpunit.xml.dist" ]; }; then
      RAN_ANY=1
      TESTS_OK=0
      env_missing "PHP" "$(php_install_hint)"
    elif command -v composer >/dev/null 2>&1 && grep -q '"test"' "$REPO_ROOT/composer.json" 2>/dev/null; then
      RAN_ANY=1
      run_to "$QG_TIMEOUT" composer test || TESTS_OK=0
    fi
  fi

  # --- JVM (not scoped: mvn/gradle don't expose a reliable "just these tests") ---
  if [ -f "$REPO_ROOT/pom.xml" ]; then
    if [ -x "$REPO_ROOT/mvnw" ]; then
      RAN_ANY=1
      [ "$SCOPED_TESTS" = "1" ] && note "Maven cannot be reliably scoped down; running the full suite."
      run_to "$QG_TIMEOUT" "$REPO_ROOT/mvnw" -q -B test || TESTS_OK=0
    elif command -v mvn >/dev/null 2>&1; then
      RAN_ANY=1
      [ "$SCOPED_TESTS" = "1" ] && note "Maven cannot be reliably scoped down; running the full suite."
      run_to "$QG_TIMEOUT" mvn -q -B test || TESTS_OK=0
    else
      warn "pom.xml is present but neither ./mvnw nor 'mvn' is installed; skipping Maven tests."
    fi
  fi

  if [ -f "$REPO_ROOT/build.gradle" ] || [ -f "$REPO_ROOT/build.gradle.kts" ]; then
    if [ -x "$REPO_ROOT/gradlew" ]; then
      RAN_ANY=1
      [ "$SCOPED_TESTS" = "1" ] && note "Gradle cannot be reliably scoped down; running the full suite."
      run_to "$QG_TIMEOUT" "$REPO_ROOT/gradlew" test || TESTS_OK=0
    elif command -v gradle >/dev/null 2>&1; then
      RAN_ANY=1
      run_to "$QG_TIMEOUT" gradle test || TESTS_OK=0
    else
      warn "build.gradle is present but neither ./gradlew nor 'gradle' is installed; skipping tests."
    fi
  fi

  if [ "$RAN_ANY" = "0" ]; then
    note "No test suites were run for this stack; skipping."
    pass "Test Suites"
  elif [ "$TESTS_OK" = "1" ]; then
    pass "Test Suites"
  else
    fail "Test Suites"
  fi
fi

echo ""
if [ "$FAILED" = "1" ]; then
  echo "🛑 Quality Gate failed. Push canceled. Failing checks:"
  printf '%s' "$FAILED_STEPS"
  echo ""
  echo "To skip a specific check (not the whole gate):"
  echo "  QG_SKIP=gitleaks git push          # gitleaks,commits,lint,design,tests"
  echo "To scope lint and tests to the files in the push:"
  echo "  QG_SCOPE=changed git push"
  exit 1
fi

echo "🚀 All good. Proceeding with git push..."
exit 0
