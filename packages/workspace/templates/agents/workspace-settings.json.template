{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-statusline.sh\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-repo-boundary.sh\""}]
      },
      {
        "matcher": "Edit",
        "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-repo-boundary.sh\""}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-repo-boundary.sh\""}]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-repo-boundary.sh\""}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-lavish-html.sh\""}]
      },
      {
        "matcher": "Edit",
        "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-lavish-html.sh\""}]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Agent(*)",
      "Write(./repositories/**)",
      "Edit(./repositories/**)",
      "Write(./docs/**)",
      "Edit(./docs/**)",

      "Bash(.claude/scripts/jira-get.sh *)",
      "Bash(.claude/scripts/jira-attachment.sh *)",
      "Bash(.claude/scripts/jira-update.sh *)",
      "Bash(.claude/scripts/utils.sh *)",
      "Bash(.claude/scripts/session-cost.sh *)",
      "Bash(.claude/scripts/lavish-brand.sh *)",
      "Bash(npx -y lavish-axi:*)",
      "Bash(./docker/scripts/run-unit-tests.sh *)",
      "Bash(./docker/scripts/stop-test-runners.sh *)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",

      "Bash(gh pr:*)",
      "Bash(gh api:*)",

      "Bash(grep * repositories/*)",
      "Bash(find repositories/*)"
    ]
  }
}
