{
  "project_name": "nombre-del-proyecto",
  "domain": "dominio-proyecto.com",
  "namespaces": [
    "core",
    "merchants",
    "farmers",
    "partners"
  ],
  "env_slugs": [
    "dev",
    "sandbox",
    "staging",
    "preprod",
    "production"
  ],
  "environments": [
    {
      "id": "dev",
      "cluster": "dev",
      "namespace": "sandbox",
      "label": "Desarrollo Local",
      "description": [
        "Ambiente de desarrollo local.",
        "Utilizado para flujos diarios e integraciones locales."
      ]
    },
    {
      "id": "staging",
      "cluster": "dev",
      "namespace": "staging",
      "label": "Staging",
      "description": [
        "Ambiente de pruebas staging.",
        "Refleja el entorno productivo para validaciones finales."
      ]
    },
    {
      "id": "production",
      "cluster": "prod",
      "namespace": "production",
      "label": "Producción",
      "description": [
        "⚠ Ambiente de producción.",
        "Solo lectura/acceso bajo permisos específicos."
      ]
    }
  ],
  "artifact_registry_domain": "artifact_registry-domain-name",
  "repositories_dir_env_var": "PROJECT_REPOSITORIES_DIR",
  "local_envs_dir_name": "local-envs",
  "workspaces_dir_name": "workspaces",
  "toolkit_dir_name": "project-toolkit",
  "url_pattern": "https?://([a-z0-9-]+)\\.(?:dev|prod)\\.dominio-proyecto\\.com(/[^\\s]*)?",
  "vpn": {
    "config_dev": "~/project-dev.ovpn",
    "config_prod": "~/project-prd.ovpn",
    "session_name_dev": "project-dev-session",
    "session_name_prod": "project-prd-session",
    "internal_host": "internal.service.dominio-proyecto.com",
    "validation_timeout": 3
  }
}
